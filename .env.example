# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real token.

# ── Required ──────────────────────────────────────────────────────────────────

# Notion integration token
# Create at: https://www.notion.so/profile/integrations
# Share each database/page with the integration via ··· → Connections
NOTION_TOKEN=your_integration_token_here

# ── Optional ──────────────────────────────────────────────────────────────────

# Port (Railway injects this automatically — do not set on Railway)
# PORT=8080

# Override logo path used in generated PDFs
# Defaults to: static/logo_transparent.png (relative to app root)
# LOGO_PATH=/absolute/path/to/logo_transparent.png

# ── Notion resource IDs (for reference — hardcoded in notion/ package) ───────
# Weekly Update DB  : 2e7c88be4d3c8014a3edccf7ee3fd496
# BD Pipeline DB    : 34fc88be4d3c8045ab26df687a6be8ce
# Marketing Cal DB  : 34fc88be4d3c804fb02ed1ede853dc10
